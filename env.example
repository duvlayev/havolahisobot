# Telegram bot sozlamalari — bu faylni ".env" nomi bilan nusxalab, o'z
# qiymatlaringizni kiriting. ".env" fayl hech qachon kodga yoki Git'ga
# qo'shilmasligi kerak (maxfiy ma'lumot).

# @BotFather orqali yaratilgan bot tokeni (masalan "123456789:AAExampleTokenHere")
TELEGRAM_BOT_TOKEN=

# Bot admin qilib qo'shilgan Telegram guruh ID (manfiy son bo'lishi mumkin,
# masalan "-1001234567890"). Buni aniqlash uchun guruhga bot bilan birga
# "@RawDataBot" yoki shunga o'xshash botni vaqtincha qo'shib, "chat":{"id": ...}
# qiymatini olishingiz mumkin.
TELEGRAM_GROUP_ID=

# (Ixtiyoriy) Xatoliklar haqida shaxsiy xabar olish uchun sizning Telegram
# foydalanuvchi ID'ingiz (guruh ID emas). Bo'sh qoldirilsa, xatoliklar faqat
# log faylga va veb-sahifadagi "Oxirgi faoliyat" ro'yxatiga yoziladi.
TELEGRAM_ADMIN_CHAT_ID=

# Flask sozlamalari (avvaldan mavjud, shu yerda ham belgilash mumkin)
SECRET_KEY=
ADMIN_PASSWORD=
